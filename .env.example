# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.
# Safe only while the port is published on 127.0.0.1 (the default in docker-compose.yml). Set to 0 once you use a password.
TESTBENCH_ALLOW_NO_AUTH=1
# Shared login password, at least 8 characters. Leave empty for no login.
TESTBENCH_PASSWORD=
# Extra host names the app answers to (exact names, comma-separated, no wildcards), for example behind a reverse proxy: testbench.example.com
# localhost and 127.0.0.1 are always allowed. A name that points at a tunnel or Funnel makes the app reachable from the internet:
# set TESTBENCH_PASSWORD first.
TESTBENCH_ALLOWED_HOSTS=
# For importing GitHub Actions runs: a token with read access to the repository.
GITHUB_TOKEN=
# Optional: create Linear issues from failing tests (a personal API key from Linear, Settings > Account > Security & access).
LINEAR_API_KEY=
# Default Linear team: its short key (ENG) or id. Leave empty to choose in the dialog.
LINEAR_TEAM_ID=
# Optional: create Jira Cloud issues from failing tests. API token: id.atlassian.com > Security > API tokens.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Issue type to create (default Bug).
JIRA_ISSUE_TYPE=

# TestPilot (the test agent). It runs from Claude Code on your own computer, not inside Docker, and docker-compose.yml does not pass these to the container.
# Its deliver step signs in with TESTBENCH_PASSWORD above. One agent token per Testbench project (created in Testbench, under the project's agent tokens);
# the variable name must match tokenEnvVar in .testpilot/projects/<key>.json. Never write a token in a config file.
# TESTBENCH_API_TOKEN_SHOP=
