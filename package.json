{
  "name": "testbench",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "mcp": "tsx mcp/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:python": "python3 -m unittest discover -s testpilot/tests",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:roles": "node scripts/check-roles-ui.mjs",
    "accounts": "tsx scripts/accounts.ts",
    "audit:package": "tsx scripts/audit-package.ts",
    "audit:export:testbench": "tsx scripts/audit-export-testbench.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tanstack/react-query": "^5.108.2",
    "better-sqlite3": "^13.2.0",
    "croner": "^11.0.1",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
