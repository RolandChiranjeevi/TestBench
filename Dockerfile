# Testbench: build the web app and the native database module, then run the server with Chromium (for PDF reports)
# in a smaller runtime image that has no compilers.
FROM node:24-bookworm-slim AS build
WORKDIR /app
# better-sqlite3 has no prebuilt binary for every platform, so it may be compiled here.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:24-bookworm-slim
ENV NODE_ENV=production \
    TESTBENCH_HOST=0.0.0.0 \
    TESTBENCH_PORT=4100 \
    TESTBENCH_DATA=/data \
    TESTBENCH_CHROME_PATH=/usr/bin/chromium \
    TESTBENCH_CHROME_NO_SANDBOX=1
# Chromium renders the sprint report PDFs. The reports are generated by Testbench itself and loaded with network access blocked.
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json tsconfig.json ./
COPY server ./server
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME /data
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.TESTBENCH_PORT||4100)+'/api/auth/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npx", "tsx", "server/index.ts"]
